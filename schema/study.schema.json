{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "blindpanel": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "instrument": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,32}$"
    },
    "privacy": {
      "default": "No names, accounts, cookies, IP addresses or browser details are stored. Opting in sends a random session id, your answers, their order and a rounded duration.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "media": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1
        },
        "origins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false
    },
    "blinding": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "banned_terms_file": {
          "type": "string"
        },
        "embedded_provenance": {
          "default": "allow",
          "type": "string",
          "const": "allow"
        }
      },
      "required": [
        "seed"
      ],
      "additionalProperties": false
    },
    "scales": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "labels": {
            "minItems": 5,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "required": [
          "labels"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "part": {
            "type": "string",
            "enum": [
              "baseline",
              "clips"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "direction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "notes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "intro_notes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "scale": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "required": [
          "id",
          "part",
          "text",
          "scale"
        ],
        "additionalProperties": false
      }
    },
    "parts": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "object",
          "properties": {
            "intro": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "additionalProperties": false
        },
        "clips": {
          "type": "object",
          "properties": {
            "intro": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "watch_note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "clip_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 600
            },
            "session_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "extend": {
              "default": false,
              "type": "boolean"
            },
            "video": {
              "default": {},
              "type": "object",
              "properties": {
                "loop": {
                  "default": true,
                  "type": "boolean"
                },
                "autoplay": {
                  "default": "unless_reduced_motion",
                  "type": "string",
                  "enum": [
                    "unless_reduced_motion",
                    "never"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "watch_note",
            "clip_seconds",
            "session_size"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "clips"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "object",
      "properties": {
        "panels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "ref": {
                "type": "string",
                "maxLength": 64
              },
              "file": {
                "type": "string",
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "clips": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "ref": {
                "type": "string",
                "maxLength": 64
              },
              "reference": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "file": {
                "type": "string",
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "meta": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "link": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "id",
              "reference",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "panels",
        "clips"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "ratings": {
          "type": "string"
        },
        "author_slot": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        },
        "attribution": {
          "type": "string",
          "maxLength": 400
        }
      },
      "required": [
        "ratings"
      ],
      "additionalProperties": false
    },
    "modes": {
      "default": {},
      "type": "object",
      "properties": {
        "public": {
          "default": {},
          "type": "object",
          "properties": {
            "submit": {
              "default": true,
              "type": "boolean"
            },
            "tally": {
              "default": true,
              "type": "boolean"
            },
            "min_crowd_n": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "default": {},
      "type": "object",
      "properties": {
        "submit": {
          "default": "/api/submit",
          "type": "string"
        },
        "tally": {
          "default": "/api/tally",
          "type": "string"
        },
        "reveal": {
          "default": "reveal.json",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "blindpanel",
    "id",
    "title",
    "instrument",
    "media",
    "blinding",
    "scales",
    "questions",
    "parts",
    "items"
  ],
  "additionalProperties": false
}
