{
  "name": "blindpanel",
  "version": "0.1.0",
  "description": "Blinded human rating of generated video: study config, rating page, submit endpoint, export and agreement statistics.",
  "license": "MIT",
  "author": "Aaron Smiles",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "blindpanel": "bin/blindpanel.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./stats": {
      "types": "./dist/stats/index.d.ts",
      "import": "./dist/stats/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/style.css": "./dist/ui/style.css",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "sql",
    "examples/synthetic",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "schema": "node scripts/schema.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
